{{- /*gotype: go-api/pages/forgotPassword.PageData*/ -}}
{{define "content"}}
	<article class="login-layout">
		<form class="card login-card" action="/forgot-password" method="post">
			<h1>Forgot password</h1>

			{{if .ErrorMessage}}
				<h2 class="form-error">{{.ErrorMessage}}</h2>
			{{end}}


			<div class="form-control">
				<label for="username">Username</label>
				<div class="input-wrapper">
					<input type="text" id="username" name="username" required>
				</div>
			</div>

			<button type="submit" class="primary-button large form-submit">Reset password</button>

			<a href="/login">Back to login</a>
		</form>
	</article>
{{end}}
