{{- /*gotype: go-api/pages.PageData*/ -}}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>{{.PageTitle}}</title>
	<link rel="icon" href="/public/favicon.ico" sizes="48x48">
	<link rel="icon" href="/public/favicon.svg" sizes="any" type="image/svg+xml">
	<link rel="stylesheet" href="/public/reset.css">
	<link rel="stylesheet" href="/public/styles.css?v={{.StylesHash}}">
	<script type="module" src="/public/htmx/htmx4.0.0.min.js" defer></script>
	{{block "head".}}{{end}}
</head>
<body>
{{block "nav".}}{{end}}
<main>
	{{template "content".}}
</main>
</body>
</html>
